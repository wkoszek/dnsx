# 1Password secret references
# Format: op://vault-name/item-name/field-name
# Replace with your actual 1Password vault/item paths

# Cloudflare - Option 1: API Token (limited permissions)
TF_VAR_cloudflare_api_token="op://infra/Cloudflare/credential"
TF_VAR_cloudflare_account_id="op://infra/Cloudflare/username"

# Cloudflare - Option 2: Global API Key (full permissions, for zone creation)
# Uncomment these and comment out the API Token above to use Global Key
# CLOUDFLARE_API_KEY="op://infra/Cloudflare/api_key"
# CLOUDFLARE_EMAIL="op://infra/Cloudflare/email"
CLOUDFLARE_ACCOUNT_ID="op://infra/Cloudflare/username"

GODADDY_API_KEY="op://infra/idp.godaddy.com/creds/password"
GODADDY_API_SECRET="op://infra/idp.godaddy.com/creds/text"

PORKBUN_API_KEY="op://infra/Porkbun/creds/text"
PORKBUN_SECRET_KEY="op://infra/Porkbun/creds/password"

GANDI_API_KEY="op://infra/Gandi_Net/api/text"
